{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>damacus/renovate-config",
    "github>damacus/renovate-config:autoMergeGitHubActions.json5",
    "github>damacus/renovate-config:cnpg.json5",
    "github>damacus/renovate-config:customManagers.json5",
    "github>damacus/renovate-config:groups.json",
    "github>damacus/renovate-config:labels.json5",
    "github>damacus/renovate-config:semanticCommits.json5",
    "github>damacus/renovate-config:packageRules.json5",
    "github>damacus/renovate-config:autoMergeSelect.json5",
  ],
  platformAutomerge: false,
  customDatasources: {
    "release-mirror": {
      defaultRegistryUrlTemplate: "file://.renovate-feeds/{{packageName}}.json",
      format: "json",
    },
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/apps/dev/git-triage/migration/job\\.yaml$/"],
      matchStrings: ["name: git-triage-migrate-(?<currentValue>build-\\d+\\.\\d+)"],
      depNameTemplate: "ghcr.io/damacus/git-triage",
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/apps/dev/forgejo/app/helmrelease\\.yaml$/"],
      matchStrings: [
        "tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+-rootless)\"",
      ],
      depNameTemplate: "code.forgejo.org/forgejo/forgejo",
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/apps/dev/supermarket/README\\.md$/"],
      matchStrings: [
        "Upstream source watch: `(?<currentValue>main)@(?<currentDigest>[a-f0-9]{40})`",
      ],
      depNameTemplate: "https://gitlab.com/cinc-project/distribution/cinc-supermarket.git",
      datasourceTemplate: "git-refs",
      versioningTemplate: "git",
    },
  ],
  packageRules: [
    {
      description: "Roll out each verified Git Triage build with its migration Job",
      matchPackageNames: ["ghcr.io/damacus/git-triage"],
      versioning: "regex:^build-(?<major>\\d+)\\.(?<minor>\\d+)$",
      groupName: "Git Triage rollout",
      separateMajorMinor: false,
      automerge: true,
    },
    // Keep native manifest parsing/replacement, but never query these registries
    // for the managed images. Public aliases belong only in the feed URL.
    {
      description: "Read Ironbridge versions and digests from Release Mirror",
      matchDatasources: ["docker"],
      matchPackageNames: ["forgejo.ironstone.casa/damacus/ironbridge"],
      overrideDatasource: "custom.release-mirror",
      overridePackageName: "ironbridge",
      versioning: "semver",
    },
    {
      description: "Track Ledger releases through Release Mirror, including the move from main",
      matchDatasources: ["docker"],
      matchPackageNames: ["forgejo.ironstone.casa/damacus/usage-ledger"],
      overrideDatasource: "custom.release-mirror",
      overridePackageName: "usage-ledger",
      // Treat the current main tag as 0.0.0 so Renovate can propose the first stable release.
      versioning: "regex:^(?:main|v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+))$",
    },
    {
      description: "Track NorthBot releases through Release Mirror, including the move from main",
      matchDatasources: ["docker"],
      matchPackageNames: ["forgejo.ironstone.casa/damacus/northbot"],
      overrideDatasource: "custom.release-mirror",
      overridePackageName: "northbot",
      versioning: "regex:^(?:main|v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+))$",
    },
    {
      description: "Pin catalogue image digests",
      matchDatasources: ["custom.release-mirror"],
      pinDigests: true,
      digest: { enabled: true },
    },
    {
      description: "Keep checked MedTracker trial images immutable; do not look for latest",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/damacus/med-tracker-loco",
      ],
      enabled: false,
    },
    {
      description: "Watch CINC Supermarket main until upstream publishes ordered image tags",
      matchDatasources: ["git-refs"],
      matchPackageNames: [
        "https://gitlab.com/cinc-project/distribution/cinc-supermarket.git",
      ],
      sourceUrl: "https://gitlab.com/cinc-project/distribution/cinc-supermarket",
      enabled: true,
      groupName: "CINC Supermarket source",
      prBodyNotes: [
        "This is an upstream source notification, not a deployable image update. Verify the successful GitLab main pipeline and published multi-arch image, then update the API, worker, gateway and bootstrap tag/digest together and rename the bootstrap Job. Keep the completed trial import unchanged. See kubernetes/apps/dev/supermarket/README.md.",
      ],
    },
    {
      description: "Keep CINC Supermarket image changes coordinated",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "registry.gitlab.com/cinc-project/distribution/cinc-supermarket",
      ],
      sourceUrl: "https://gitlab.com/cinc-project/distribution/cinc-supermarket",
      groupName: "CINC Supermarket images",
    },
    {
      description: "Preserve the completed CINC trial import",
      matchFileNames: ["kubernetes/apps/dev/supermarket/import/job.yaml"],
      enabled: false,
    },
    {
      description: "Group and auto-merge non-major Penpot container updates",
      groupName: "penpot containers",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "penpotapp/backend",
        "penpotapp/exporter",
        "penpotapp/frontend",
      ],
      matchUpdateTypes: ["digest", "minor", "patch", "pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "Group Flux platform updates",
      groupName: "flux",
      matchPackageNames: [
        "controlplaneio-fluxcd/distribution",
        "fluxcd/flux2",
        "ghcr.io/controlplaneio-fluxcd/charts/flux-instance",
        "ghcr.io/controlplaneio-fluxcd/charts/flux-operator",
        "ghcr.io/fluxcd/flux-manifests",
      ],
    },
    {
      description: "Auto-merge non-major updates for selected home-ops assets",
      matchPackageNames: [
        "jdx/mise",
        "jdx/mise-action",
        "kustomize",
        "yq",
        "ghcr.io/cloudnative-pg/plugin-barman-cloud",
        "ghcr.io/cloudnative-pg/plugin-barman-cloud-sidecar",
        "ghcr.io/coder/code-server",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/home-operations/home-assistant",
        "ghcr.io/mealie-recipes/mealie",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "registry.k8s.io/kubectl",
        "rustfs/rc",
        "ghcr.io/zitadel/zitadel",
        "quay.io/jetstack/charts/cert-manager",
        "external-secrets",
        "victoria-metrics-k8s-stack",
        "zitadel",
      ],
      matchUpdateTypes: ["digest", "minor", "patch", "pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "Auto-merge non-major service and shared-chart updates",
      matchPackageNames: [
        "gh",
        "ghcr.io/home-operations/charts/gatus-sidecar",
        "rhasspy/wyoming-whisper",
        "rhasspy/wyoming-piper",
        "rhasspy/wyoming-openwakeword",
        "ghcr.io/traefik/helm/traefik",
        "docker.io/cloudflare/cloudflared",
        "external-dns",
        "ghcr.io/mendhak/http-https-echo",
        "cloudnative-pg",
        "openebs",
        "longhorn",
        "volsync",
        "rustfs/rustfs",
        "ghcr.io/dragonflydb/dragonfly",
        "ghcr.io/dragonflydb/operator",
        "dragonflydb/dragonfly-operator",
        "app-template",
        "ghcr.io/bjw-s-labs/helm/app-template",
        "keda-add-ons-http",
        "prometheus-operator-crds",
      ],
      matchUpdateTypes: ["digest", "minor", "patch", "pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "Auto-merge patch updates for selected services, controllers and tools",
      matchPackageNames: [
        "ghcr.io/matter-js/matterjs-server",
        "ghcr.io/berriai/litellm",
        "ghcr.io/emberstack/helm-charts/reflector",
        "csi-driver-nfs",
        "csi-driver-smb",
        "python",
        "code.forgejo.org/forgejo/forgejo",
        "forgejo",
        "ghcr.io/stakater/charts/reloader",
      ],
      matchUpdateTypes: ["digest", "patch", "pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "Group production MedTracker upgrades",
      matchFileNames: ["kubernetes/apps/home/med-tracker/**"],
      groupName: "MedTracker production",
    },
    {
      description: "Auto-merge updates after the release has aged",
      matchPackageNames: ["*"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      minimumReleaseAge: "48 hours",
      minimumReleaseAgeBehaviour: "timestamp-required",
    },
    {
      description: "Auto-merge MedTracker releases without an age delay",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/damacus/med-tracker"],
      enabled: true,
      automerge: true,
      ignoreTests: false,
      minimumReleaseAge: null,
    },
  ],
}

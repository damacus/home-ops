#!/usr/bin/env bash
#MISE description="Purge only Armbian-owned Docker build data"
#MISE quiet=true
#USAGE flag "--reclaim" help="Run the official Docker Desktop space reclaimer after Armbian purge"
#USAGE flag "--dry-run" help="List the scoped purge operations"
set -euo pipefail

args=()
[[ "${usage_reclaim:-false}" == "true" ]] && args+=(--reclaim)
[[ "${usage_dry_run:-false}" == "true" ]] && args+=(--dry-run)
exec python3 "${MISE_PROJECT_ROOT}/provisioning/provision.py" docker-purge "${args[@]}"

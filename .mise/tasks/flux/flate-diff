#!/usr/bin/env bash
#MISE description="Diff rendered Flux resources with flate"
#MISE quiet=true
#USAGE flag "--path <path>" help="Current Kubernetes manifest path (default: ./kubernetes)"
#USAGE flag "--path-orig <path>" help="Original Kubernetes manifest path"
#USAGE flag "--base <ref>" help="Git base ref when --path-orig is omitted (default: origin/main)"
#USAGE flag "--output <format>" help="Flate output format (default: human)"
set -euo pipefail

path="${usage_path:-./kubernetes}"
path_orig="${usage_path_orig:-}"
base="${usage_base:-origin/main}"
output="${usage_output:-human}"
command -v flate >/dev/null || { printf 'Missing flate\n' >&2; exit 1; }
command -v git >/dev/null || { printf 'Missing git\n' >&2; exit 1; }
# This command resolves --base to an explicit worktree and passes --path-orig.
# Do not let Flate also infer --base from the caller's environment.
unset FLATE_BASE
api_versions='policy/v1/PodDisruptionBudget,monitoring.coreos.com/v1,monitoring.coreos.com/v1/ServiceMonitor,monitoring.coreos.com/v1/PodMonitor,monitoring.coreos.com/v1/PrometheusRule'
if [ -n "$path_orig" ]; then
  exec flate --no-progress diff all --api-versions "$api_versions" --path "$path" --path-orig "$path_orig" -o "$output"
fi
tmp_dir="$(mktemp -d)"
cleanup() {
  git worktree remove --force "$tmp_dir/base" >/dev/null 2>&1 || rm -rf "$tmp_dir"
}
trap cleanup EXIT
git worktree add --detach "$tmp_dir/base" "$base"
orig_path="$tmp_dir/base/${path#./}"
flate --no-progress diff all --api-versions "$api_versions" --path "$path" --path-orig "$orig_path" -o "$output"

#!/usr/bin/env bash
#MISE description="Run the recurring morning cluster health bundle from composable subtasks"
#MISE quiet=true
#MISE raw=true
set -euo pipefail

notify=false
edge_smoke=true
log_noise=false
child_args=()
for argument in "$@"; do
  case "$argument" in
    format=text|format=ndjson)
      child_args+=(--format "${argument#format=}")
      ;;
    format=*)
      printf 'Unsupported format; use format=text or format=ndjson\n' >&2
      exit 2
      ;;
    notify=true)
      notify=true
      ;;
    notify=*)
      ;;
    verbose=true)
      child_args+=(--verbose)
      ;;
    verbose=*)
      ;;
    raw=true)
      child_args+=(--raw)
      ;;
    raw=*)
      ;;
    timeout=*)
      child_args+=(--timeout "${argument#timeout=}s")
      ;;
    period=*)
      child_args+=(--period "${argument#period=}")
      ;;
    top=*)
      child_args+=(--top "${argument#top=}")
      ;;
    skip_http3=true)
      child_args+=(--skip-http3)
      ;;
    skip_http3=*)
      ;;
    include_esphome_canary=true)
      child_args+=(--include-esphome-canary)
      ;;
    include_esphome_canary=*)
      ;;
    esphome_ws_path=*)
      child_args+=(--esphome-websocket-path "${argument#esphome_ws_path=}")
      ;;
    esphome_ws_contains=*)
      child_args+=(--esphome-websocket-contains "${argument#esphome_ws_contains=}")
      ;;
    edge_smoke=true)
      edge_smoke=true
      ;;
    edge_smoke=*)
      edge_smoke=false
      ;;
    log_noise=true)
      log_noise=true
      ;;
    log_noise=*)
      log_noise=false
      ;;
    json=true)
      printf 'json=true was removed; use format=ndjson\n' >&2
      exit 2
      ;;
    json=*)
      ;;
    workers=*)
      if [ -n "${argument#workers=}" ]; then
        printf 'workers= was removed; Mise now composes checks deterministically\n' >&2
        exit 2
      fi
      ;;
    --notify|--notify=true)
      notify=true
      ;;
    --notify=false)
      ;;
    --edge-smoke)
      edge_smoke=true
      ;;
    --no-edge-smoke)
      edge_smoke=false
      ;;
    --log-noise)
      log_noise=true
      ;;
    --no-log-noise)
      log_noise=false
      ;;
    *)
      child_args+=("$argument")
      ;;
  esac
done

checks=(health gitops-health external-secrets-health service-account-health cnpg-backups)
if [ "$edge_smoke" = true ]; then
  checks+=(edge-smoke)
fi
if [ "$log_noise" = true ]; then
  checks+=(log-noise)
fi

failed=0
for check in "${checks[@]}"; do
  if ! mise run "kubernetes:$check" -- "${child_args[@]}"; then
    failed=1
  fi
done

if [ "$failed" -ne 0 ] && [ "$notify" = true ]; then
  if ! scripts/notify \
    --status failure \
    --title "Cluster health: action needed" \
    --message "One or more cluster health checks failed; see task output for the affected report."; then
    printf 'send notification: failed\n' >&2
  fi
fi

exit "$failed"

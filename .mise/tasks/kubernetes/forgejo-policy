#!/usr/bin/env bash
#MISE description="Validate the Forgejo v16 and production-hardening manifest contract"
#MISE quiet=true
#MISE raw=true
set -euo pipefail

policy="$PWD/tests/mondoo/forgejo.mql.yaml"
command -v cnspec >/dev/null || { printf 'Missing cnspec\n' >&2; exit 1; }
[ -f "$policy" ] || { printf 'Missing Forgejo policy\n' >&2; exit 1; }
cnspec --auto-update=false policy lint "$policy"
exec cnspec --auto-update=false scan local --policy-bundle "$policy" --incognito --risk-threshold 1

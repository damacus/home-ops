{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::chunks",
        "arn:aws:s3:::ruler",
        "arn:aws:s3:::admin"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::chunks/*",
        "arn:aws:s3:::ruler/*",
        "arn:aws:s3:::admin/*"
      ]
    }
  ]
}

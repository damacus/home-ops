#!/usr/bin/env bash
#MISE description="Get all alerts from VictoriaMetrics"
#MISE quiet=true
#MISE raw=true
set -euo pipefail
kubectl exec -n monitoring vmalertmanager-vm-0 -- wget -qO- 'http://localhost:9093/api/v2/alerts' 2>/dev/null |
  jq -r '.[] | "\(.labels.alertname): \(.status.state)"' |
  sort |
  uniq -c |
  sort -rn

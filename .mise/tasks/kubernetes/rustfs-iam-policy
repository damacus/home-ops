#!/usr/bin/env bash
#MISE description="Validate RustFS per-app IAM policy with Mondoo cnspec"
#MISE quiet=true
#MISE raw=true
set -euo pipefail

policy="$PWD/tests/mondoo/rustfs-iam.mql.yaml"
command -v cnspec >/dev/null || { printf 'Missing cnspec\n' >&2; exit 1; }
[ -f "$policy" ] || { printf 'Missing RustFS IAM policy\n' >&2; exit 1; }
cnspec --auto-update=false policy lint "$policy"
exec cnspec --auto-update=false scan local --policy-bundle "$policy" --incognito

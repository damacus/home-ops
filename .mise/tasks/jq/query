#!/usr/bin/env bash
#MISE description="Run a jq query on a JSON file"
#MISE quiet=true
#MISE raw=true
set -euo pipefail

file=
query=
for argument in "$@"; do
  case "$argument" in
    FILE=*) file="${argument#FILE=}" ;;
    QUERY=*) query="${argument#QUERY=}" ;;
    *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 2 ;;
  esac
done
[ -n "$file" ] && [ -n "$query" ] || { printf 'FILE and QUERY are required\n' >&2; exit 1; }
jq "$query" "$file"

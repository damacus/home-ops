#!/usr/bin/env bash
#MISE description="Run Mondoo checks against rendered Flux Kubernetes manifests"
#MISE quiet=true
#MISE raw=true
#USAGE flag "--path <path>" help="Manifest root (default: ./kubernetes)"
#USAGE flag "--no-include-posture" help="Skip posture checks"
#USAGE flag "--output <format>" help="Mondoo output format"
#USAGE flag "--report-dir <path>" help="Directory for reports"
set -euo pipefail

command -v python3 >/dev/null || { printf 'Missing Python interpreter\n' >&2; exit 1; }
command -v cnspec >/dev/null || { printf 'Missing cnspec\n' >&2; exit 1; }
command -v flate >/dev/null || { printf 'Missing flate\n' >&2; exit 1; }
script="$PWD/scripts/mondoo_scan.py"
[ -f "$script" ] || { printf 'Missing Mondoo wrapper\n' >&2; exit 1; }
args=()
[ -n "${usage_output:-}" ] && args+=(--output "${usage_output}")
[ -n "${usage_report_dir:-}" ] && args+=(--report-dir "${usage_report_dir}")
subcommand_args=(--path "${usage_path:-./kubernetes}")
[ "${usage_no_include_posture:-false}" = true ] || subcommand_args+=(--include-posture)
exec python3 "$script" "${args[@]}" k8s-manifests "${subcommand_args[@]}"

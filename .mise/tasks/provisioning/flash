#!/usr/bin/env bash
#MISE description="Verify and flash a local Radxa image to an explicit device"
#MISE quiet=true
#USAGE arg "<artifact>" help="Local .img.xz artifact"
#USAGE arg "<device>" help="Explicit block device"
#USAGE flag "--dry-run" help="Print the local no-download flash plan"
set -euo pipefail
# Variables are supplied by Mise's usage parser.
# shellcheck disable=SC2154

args=("${usage_artifact}" "${usage_device}")
[[ "${usage_dry_run:-false}" == "true" ]] && args+=(--dry-run)
cd "${MISE_PROJECT_ROOT}"
exec go run ./cmd/provisioning flash "${args[@]}"

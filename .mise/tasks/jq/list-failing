#!/usr/bin/env bash
#MISE description="List all items with passes=false"
#MISE quiet=true
#MISE raw=true
set -euo pipefail

file=
for argument in "$@"; do case "$argument" in FILE=*) file="${argument#FILE=}" ;; *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 2 ;; esac; done
[ -n "$file" ] || { printf 'FILE is required\n' >&2; exit 1; }
jq -r '.[] | select(.passes == false) | "\(.category): \(.description)"' ".tasks/$file.json"

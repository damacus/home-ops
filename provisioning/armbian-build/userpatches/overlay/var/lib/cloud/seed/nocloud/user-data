#cloud-config
preserve_hostname: true
timezone: Europe/London
locale: en_GB.UTF-8
disable_root: true
ssh_pwauth: false
ssh_genkeytypes: [ed25519, rsa]
ssh_deletekeys: true
users:
  - name: pi
    gecos: Ironstone Admin
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMCLr7NoB34qERAAJNLHKgOy9EJ40smz4F9HhU5d5i8s
bootcmd:
  - [cloud-init-per, once, ironstone-hostname, /usr/local/bin/ironstone-init.sh]

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>damacus/renovate-config",
    "github>damacus/renovate-config:autoMergeGitHubActions.json5",
    "github>damacus/renovate-config:cnpg.json5",
    "github>damacus/renovate-config:customManagers.json5",
    "github>damacus/renovate-config:groups.json",
    "github>damacus/renovate-config:labels.json5",
    "github>damacus/renovate-config:semanticCommits.json5",
    "github>damacus/renovate-config:packageRules.json5",
    "github>damacus/renovate-config:autoMergeSelect.json5",
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/apps/dev/supermarket/README\\.md$/"],
      matchStrings: [
        "Upstream source watch: `(?<currentValue>main)@(?<currentDigest>[a-f0-9]{40})`",
      ],
      depNameTemplate: "https://gitlab.com/cinc-project/distribution/cinc-supermarket.git",
      datasourceTemplate: "git-refs",
      versioningTemplate: "git",
    },
  ],
  packageRules: [
    {
      description: "Watch CINC Supermarket main until upstream publishes ordered image tags",
      matchDatasources: ["git-refs"],
      matchPackageNames: ["https://gitlab.com/cinc-project/distribution/cinc-supermarket.git"],
      sourceUrl: "https://gitlab.com/cinc-project/distribution/cinc-supermarket",
      enabled: true,
      automerge: false,
      groupName: "CINC Supermarket source",
      prBodyNotes: [
        "This is an upstream source notification, not a deployable image update. Verify the successful GitLab main pipeline and published multi-arch image, then update the API, worker, gateway and bootstrap tag/digest together and rename the bootstrap Job. Keep the completed trial import unchanged. See kubernetes/apps/dev/supermarket/README.md.",
      ],
    },
    {
      description: "Keep CINC Supermarket image changes coordinated and manually reviewed",
      matchDatasources: ["docker"],
      matchPackageNames: ["registry.gitlab.com/cinc-project/distribution/cinc-supermarket"],
      sourceUrl: "https://gitlab.com/cinc-project/distribution/cinc-supermarket",
      groupName: "CINC Supermarket images",
      automerge: false,
    },
    {
      description: "Preserve the completed CINC trial import",
      matchFileNames: ["kubernetes/apps/dev/supermarket/import/job.yaml"],
      enabled: false,
    },
    {
      description: "Group and auto-merge non-major Penpot container updates",
      groupName: "penpot containers",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "penpotapp/backend",
        "penpotapp/exporter",
        "penpotapp/frontend",
      ],
      matchUpdateTypes: ["digest", "minor", "patch", "pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "Group Flux platform updates",
      groupName: "flux",
      matchPackageNames: [
        "controlplaneio-fluxcd/distribution",
        "fluxcd/flux2",
        "ghcr.io/controlplaneio-fluxcd/charts/flux-instance",
        "ghcr.io/controlplaneio-fluxcd/charts/flux-operator",
        "ghcr.io/fluxcd/flux-manifests",
      ],
    },
    {
      description: "Enable MedTracker updates without auto-merge",
      matchPackageNames: ["ghcr.io/damacus/med-tracker"],
      enabled: true,
      automerge: false,
    },
    {
      description: "Hold Vector below 0.57 until Loki template confinement is resolved",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["timberio/vector", "vector"],
      allowedVersions: "<0.57.0",
    },
    {
      description: "Auto-merge non-major updates for selected home-ops assets",
      matchPackageNames: [
        "jdx/mise",
        "ghcr.io/coder/code-server",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/home-operations/home-assistant",
        "ghcr.io/mealie-recipes/mealie",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "registry.k8s.io/kubectl",
        "rustfs/rc",
        "ghcr.io/zitadel/zitadel",
        "quay.io/jetstack/charts/cert-manager",
        "external-secrets",
        "victoria-metrics-k8s-stack",
        "zitadel",
      ],
      matchUpdateTypes: ["digest", "minor", "patch", "pin", "pinDigest"],
      automerge: true,
    },
  ],
}

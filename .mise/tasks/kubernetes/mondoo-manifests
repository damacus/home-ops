#!/usr/bin/env bash
#MISE description="Run Mondoo checks against rendered Flux Kubernetes manifests"
#MISE quiet=true
#MISE raw=true
set -euo pipefail

path=./kubernetes
include_posture=true
output=
report_dir=
for argument in "$@"; do
  case "$argument" in
    path=*) path="${argument#path=}" ;;
    include_posture=*) include_posture="${argument#include_posture=}" ;;
    output=*) output="${argument#output=}" ;;
    report_dir=*) report_dir="${argument#report_dir=}" ;;
    *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 2 ;;
  esac
done
command -v python3 >/dev/null || { printf 'Missing Python interpreter\n' >&2; exit 1; }
command -v cnspec >/dev/null || { printf 'Missing cnspec\n' >&2; exit 1; }
command -v flate >/dev/null || { printf 'Missing flate\n' >&2; exit 1; }
script="$PWD/scripts/mondoo_scan.py"
[ -f "$script" ] || { printf 'Missing Mondoo wrapper\n' >&2; exit 1; }
args=()
[ -n "$output" ] && args+=(--output "$output")
[ -n "$report_dir" ] && args+=(--report-dir "$report_dir")
subcommand_args=(--path "$path")
[ "$include_posture" = true ] && subcommand_args+=(--include-posture)
exec python3 "$script" "${args[@]}" k8s-manifests "${subcommand_args[@]}"

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::openebs-loki-archive-chunks",
        "arn:aws:s3:::openebs-loki-archive-ruler",
        "arn:aws:s3:::openebs-loki-archive-admin",
        "arn:aws:s3:::openebs-loki-archive-manifests"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::openebs-loki-archive-chunks/*",
        "arn:aws:s3:::openebs-loki-archive-ruler/*",
        "arn:aws:s3:::openebs-loki-archive-admin/*",
        "arn:aws:s3:::openebs-loki-archive-manifests/*"
      ]
    }
  ]
}
